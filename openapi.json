{
  "openapi": "3.0.0",
  "info": {
    "title": "Cloudflare Storage Service",
    "version": "1.0.0",
    "description": "Stores and serves files on Cloudflare R2"
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "components": {
    "securitySchemes": {
      "ApiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Api-Key"
      }
    },
    "schemas": {
      "HealthResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "example": "ok"
          },
          "service": {
            "type": "string",
            "example": "cloudflare-storage-service"
          }
        },
        "required": [
          "status",
          "service"
        ]
      },
      "UploadResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "description": "File record UUID"
          },
          "url": {
            "type": "string",
            "format": "uri",
            "description": "Permanent public URL"
          },
          "size": {
            "type": "integer",
            "description": "File size in bytes"
          },
          "contentType": {
            "type": "string",
            "description": "MIME type"
          },
          "optimizedFor": {
            "type": "string",
            "enum": [
              "email"
            ],
            "description": "Present only when optimizeFor was requested and the stored bytes were re-encoded."
          },
          "width": {
            "type": "integer",
            "description": "Stored image width in pixels. Present only when optimizeFor was requested."
          },
          "height": {
            "type": "integer",
            "description": "Stored image height in pixels. Present only when optimizeFor was requested."
          }
        },
        "required": [
          "id",
          "url",
          "size",
          "contentType"
        ]
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        },
        "required": [
          "error"
        ]
      },
      "UploadRequest": {
        "type": "object",
        "properties": {
          "sourceUrl": {
            "type": "string",
            "format": "uri",
            "description": "URL to download the file from"
          },
          "folder": {
            "type": "string",
            "description": "R2 key prefix/folder"
          },
          "filename": {
            "type": "string",
            "description": "Desired filename"
          },
          "contentType": {
            "type": "string",
            "description": "MIME type"
          },
          "optimizeFor": {
            "type": "string",
            "enum": [
              "email"
            ],
            "description": "Optimise the stored object for a delivery target before writing it to R2. Omit it and the upload is stored byte-for-byte as supplied. 'email' bounds the image to 1200x1200 (fit inside, never upscaled), bakes in EXIF orientation, strips metadata, and re-encodes to JPEG (or PNG when the source has transparency) so every mail client can draw it — never WebP or AVIF. Animated GIFs are stored unchanged. The returned public URL stays a plain unauthenticated link, and the returned filename extension follows the stored format.",
            "example": "email"
          }
        },
        "required": [
          "sourceUrl"
        ]
      },
      "UploadBase64Request": {
        "type": "object",
        "properties": {
          "contentBase64": {
            "type": "string",
            "description": "Base64-encoded file content. Data URL prefixes are accepted."
          },
          "folder": {
            "type": "string",
            "description": "R2 key prefix/folder"
          },
          "filename": {
            "type": "string",
            "description": "Desired filename"
          },
          "contentType": {
            "type": "string",
            "description": "MIME type"
          },
          "optimizeFor": {
            "type": "string",
            "enum": [
              "email"
            ],
            "description": "Optimise the stored object for a delivery target before writing it to R2. Omit it and the upload is stored byte-for-byte as supplied. 'email' bounds the image to 1200x1200 (fit inside, never upscaled), bakes in EXIF orientation, strips metadata, and re-encodes to JPEG (or PNG when the source has transparency) so every mail client can draw it — never WebP or AVIF. Animated GIFs are stored unchanged. The returned public URL stays a plain unauthenticated link, and the returned filename extension follows the stored format.",
            "example": "email"
          }
        },
        "required": [
          "contentBase64"
        ]
      },
      "FileResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "folder": {
            "type": "string",
            "nullable": true
          },
          "filename": {
            "type": "string"
          },
          "contentType": {
            "type": "string",
            "nullable": true
          },
          "size": {
            "type": "integer",
            "nullable": true
          },
          "orgId": {
            "type": "string",
            "format": "uuid"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "url",
          "folder",
          "filename",
          "contentType",
          "size",
          "orgId",
          "createdAt"
        ]
      },
      "BotTrafficDailyResponse": {
        "type": "object",
        "properties": {
          "host": {
            "type": "string",
            "example": "distribute.you"
          },
          "from": {
            "type": "string"
          },
          "to": {
            "type": "string"
          },
          "categories": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "AI Assistant, AI Search, AI Crawler first, then other verified-bot categories by volume."
          },
          "days": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "date": {
                  "type": "string",
                  "example": "2026-09-28"
                },
                "captured": {
                  "type": "boolean",
                  "description": "false = no capture for this day (before capture started, outside Cloudflare's ~31-day retention, or not final yet). requests is then null, never 0."
                },
                "requests": {
                  "type": "object",
                  "nullable": true,
                  "additionalProperties": {
                    "type": "integer"
                  },
                  "description": "Requests per verified-bot category for the day (every listed category present, 0 when none).",
                  "example": {
                    "AI Assistant": 14,
                    "AI Search": 165,
                    "AI Crawler": 58
                  }
                }
              },
              "required": [
                "date",
                "captured",
                "requests"
              ]
            }
          },
          "totals": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "category": {
                  "type": "string"
                },
                "requests": {
                  "type": "integer"
                },
                "topBots": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "botName": {
                        "type": "string",
                        "example": "ChatGPT-User"
                      },
                      "requests": {
                        "type": "integer"
                      }
                    },
                    "required": [
                      "botName",
                      "requests"
                    ]
                  }
                }
              },
              "required": [
                "category",
                "requests",
                "topBots"
              ]
            }
          }
        },
        "required": [
          "host",
          "from",
          "to",
          "categories",
          "days",
          "totals"
        ]
      },
      "BotTrafficCaptureResult": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ran",
              "skipped"
            ]
          },
          "reason": {
            "type": "string"
          },
          "captured": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "day": {
                  "type": "string"
                },
                "rows": {
                  "type": "integer"
                },
                "requests": {
                  "type": "integer"
                }
              },
              "required": [
                "day",
                "rows",
                "requests"
              ]
            }
          },
          "failed": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "day": {
                  "type": "string"
                },
                "error": {
                  "type": "string"
                }
              },
              "required": [
                "day",
                "error"
              ]
            }
          }
        },
        "required": [
          "status",
          "captured",
          "failed"
        ]
      }
    },
    "parameters": {}
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Health check",
        "responses": {
          "200": {
            "description": "Service is healthy",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/upload": {
      "post": {
        "summary": "Upload a file to R2",
        "description": "Downloads a file from a given URL and uploads it to Cloudflare R2",
        "security": [
          {
            "ApiKeyAuth": []
          }
        ],
        "parameters": [
          {
            "schema": {
              "type": "string",
              "format": "uuid",
              "description": "Internal org UUID"
            },
            "required": true,
            "name": "x-org-id",
            "in": "header"
          },
          {
            "schema": {
              "type": "string",
              "format": "uuid",
              "description": "Internal user UUID"
            },
            "required": true,
            "name": "x-user-id",
            "in": "header"
          },
          {
            "schema": {
              "type": "string",
              "description": "Run ID from runs-service"
            },
            "required": true,
            "name": "x-run-id",
            "in": "header"
          },
          {
            "schema": {
              "type": "string",
              "description": "Comma-separated list of brand UUIDs (e.g. uuid1,uuid2,uuid3)",
              "example": "00000000-0000-0000-0000-000000000001,00000000-0000-0000-0000-000000000002"
            },
            "required": false,
            "name": "x-brand-id",
            "in": "header"
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UploadRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "File uploaded successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UploadResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "502": {
            "description": "Upload failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/upload/base64": {
      "post": {
        "summary": "Upload base64 content to R2",
        "description": "Decodes base64 file content from the request body and uploads it to Cloudflare R2",
        "security": [
          {
            "ApiKeyAuth": []
          }
        ],
        "parameters": [
          {
            "schema": {
              "type": "string",
              "format": "uuid",
              "description": "Internal org UUID"
            },
            "required": true,
            "name": "x-org-id",
            "in": "header"
          },
          {
            "schema": {
              "type": "string",
              "format": "uuid",
              "description": "Internal user UUID"
            },
            "required": true,
            "name": "x-user-id",
            "in": "header"
          },
          {
            "schema": {
              "type": "string",
              "description": "Run ID from runs-service"
            },
            "required": true,
            "name": "x-run-id",
            "in": "header"
          },
          {
            "schema": {
              "type": "string",
              "description": "Comma-separated list of brand UUIDs (e.g. uuid1,uuid2,uuid3)",
              "example": "00000000-0000-0000-0000-000000000001,00000000-0000-0000-0000-000000000002"
            },
            "required": false,
            "name": "x-brand-id",
            "in": "header"
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UploadBase64Request"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "File uploaded successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UploadResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "502": {
            "description": "Upload failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/internal/upload/base64": {
      "post": {
        "summary": "Upload platform base64 content to R2",
        "description": "Decodes base64 file content from an internal service caller and uploads it to Cloudflare R2 without org, user, or parent run identity.",
        "security": [
          {
            "ApiKeyAuth": []
          }
        ],
        "parameters": [
          {
            "schema": {
              "type": "string",
              "description": "Internal caller service name",
              "example": "chat-service"
            },
            "required": true,
            "name": "x-service-name",
            "in": "header"
          },
          {
            "schema": {
              "type": "string",
              "description": "Optional campaign attribution"
            },
            "required": false,
            "name": "x-campaign-id",
            "in": "header"
          },
          {
            "schema": {
              "type": "string",
              "description": "Optional comma-separated brand attribution",
              "example": "00000000-0000-0000-0000-000000000001"
            },
            "required": false,
            "name": "x-brand-id",
            "in": "header"
          },
          {
            "schema": {
              "type": "string",
              "description": "Optional workflow attribution"
            },
            "required": false,
            "name": "x-workflow-slug",
            "in": "header"
          },
          {
            "schema": {
              "type": "string",
              "description": "Optional feature attribution"
            },
            "required": false,
            "name": "x-feature-slug",
            "in": "header"
          },
          {
            "schema": {
              "type": "string",
              "description": "Optional audience attribution"
            },
            "required": false,
            "name": "x-audience-id",
            "in": "header"
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UploadBase64Request"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "File uploaded successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UploadResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request or missing x-service-name",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Invalid or missing service API key",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "502": {
            "description": "Upload failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/files/{id}": {
      "get": {
        "summary": "Get file metadata",
        "security": [
          {
            "ApiKeyAuth": []
          }
        ],
        "parameters": [
          {
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "required": true,
            "name": "id",
            "in": "path"
          },
          {
            "schema": {
              "type": "string",
              "format": "uuid",
              "description": "Internal org UUID"
            },
            "required": true,
            "name": "x-org-id",
            "in": "header"
          },
          {
            "schema": {
              "type": "string",
              "format": "uuid",
              "description": "Internal user UUID"
            },
            "required": true,
            "name": "x-user-id",
            "in": "header"
          },
          {
            "schema": {
              "type": "string",
              "description": "Run ID from runs-service"
            },
            "required": true,
            "name": "x-run-id",
            "in": "header"
          },
          {
            "schema": {
              "type": "string",
              "description": "Comma-separated list of brand UUIDs (e.g. uuid1,uuid2,uuid3)",
              "example": "00000000-0000-0000-0000-000000000001,00000000-0000-0000-0000-000000000002"
            },
            "required": false,
            "name": "x-brand-id",
            "in": "header"
          }
        ],
        "responses": {
          "200": {
            "description": "File metadata",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FileResponse"
                }
              }
            }
          },
          "404": {
            "description": "File not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      },
      "delete": {
        "summary": "Delete a file",
        "security": [
          {
            "ApiKeyAuth": []
          }
        ],
        "parameters": [
          {
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "required": true,
            "name": "id",
            "in": "path"
          },
          {
            "schema": {
              "type": "string",
              "format": "uuid",
              "description": "Internal org UUID"
            },
            "required": true,
            "name": "x-org-id",
            "in": "header"
          },
          {
            "schema": {
              "type": "string",
              "format": "uuid",
              "description": "Internal user UUID"
            },
            "required": true,
            "name": "x-user-id",
            "in": "header"
          },
          {
            "schema": {
              "type": "string",
              "description": "Run ID from runs-service"
            },
            "required": true,
            "name": "x-run-id",
            "in": "header"
          },
          {
            "schema": {
              "type": "string",
              "description": "Comma-separated list of brand UUIDs (e.g. uuid1,uuid2,uuid3)",
              "example": "00000000-0000-0000-0000-000000000001,00000000-0000-0000-0000-000000000002"
            },
            "required": false,
            "name": "x-brand-id",
            "in": "header"
          }
        ],
        "responses": {
          "204": {
            "description": "File deleted successfully"
          },
          "404": {
            "description": "File not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/images/{key}": {
      "get": {
        "summary": "Serve an image from R2 with optional resizing",
        "description": "Fetches an image from R2 by key. Supports on-the-fly resizing via query params: w (width), h (height), fit (cover|contain|fill|inside|outside), format (webp|avif|png|jpeg), quality (1-100).",
        "security": [
          {
            "ApiKeyAuth": []
          }
        ],
        "parameters": [
          {
            "schema": {
              "type": "string",
              "description": "R2 object key (full path)"
            },
            "required": true,
            "name": "key",
            "in": "path"
          },
          {
            "schema": {
              "type": "string",
              "description": "Max width in pixels (1-4096)"
            },
            "required": false,
            "name": "w",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "description": "Max height in pixels (1-4096)"
            },
            "required": false,
            "name": "h",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "enum": [
                "cover",
                "contain",
                "fill",
                "inside",
                "outside"
              ],
              "description": "Resize fit mode"
            },
            "required": false,
            "name": "fit",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "enum": [
                "webp",
                "avif",
                "png",
                "jpeg"
              ],
              "description": "Output format"
            },
            "required": false,
            "name": "format",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "description": "Output quality (1-100)"
            },
            "required": false,
            "name": "quality",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "format": "uuid",
              "description": "Internal org UUID"
            },
            "required": true,
            "name": "x-org-id",
            "in": "header"
          },
          {
            "schema": {
              "type": "string",
              "format": "uuid",
              "description": "Internal user UUID"
            },
            "required": true,
            "name": "x-user-id",
            "in": "header"
          },
          {
            "schema": {
              "type": "string",
              "description": "Run ID from runs-service"
            },
            "required": true,
            "name": "x-run-id",
            "in": "header"
          },
          {
            "schema": {
              "type": "string",
              "description": "Comma-separated list of brand UUIDs (e.g. uuid1,uuid2,uuid3)",
              "example": "00000000-0000-0000-0000-000000000001,00000000-0000-0000-0000-000000000002"
            },
            "required": false,
            "name": "x-brand-id",
            "in": "header"
          }
        ],
        "responses": {
          "200": {
            "description": "Image binary",
            "content": {
              "image/*": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "404": {
            "description": "Image not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "502": {
            "description": "Image processing failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/internal/bot-traffic/daily": {
      "get": {
        "summary": "Daily verified-bot traffic on distribute.you, by category and top bots",
        "description": "Staff-only. Cloudflare verified-bot requests on the distribute.you host, captured daily (hourly scheduler, a day is final once captured after 02:00 UTC the next day). 'AI Assistant' = fetched live to answer a user's question (ChatGPT-User, Claude-User, DuckAssistBot, Perplexity-User), 'AI Search' = AI search index, 'AI Crawler' = model training. Default window: the 30 days ending yesterday (UTC).",
        "security": [
          {
            "ApiKeyAuth": []
          }
        ],
        "parameters": [
          {
            "schema": {
              "type": "string",
              "description": "First UTC day, YYYY-MM-DD (default: to - 29)"
            },
            "required": false,
            "name": "from",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "description": "Last UTC day, YYYY-MM-DD (default: yesterday)"
            },
            "required": false,
            "name": "to",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "description": "Comma-separated category filter",
              "example": "AI Assistant,AI Search,AI Crawler"
            },
            "required": false,
            "name": "categories",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "description": "Top bots per category (0-50, default 10)"
            },
            "required": false,
            "name": "topBots",
            "in": "query"
          }
        ],
        "responses": {
          "200": {
            "description": "Daily series",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BotTrafficDailyResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid query",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/internal/bot-traffic/capture": {
      "post": {
        "summary": "Run the verified-bot capture now (staff-only)",
        "description": "Runs the same mutex-guarded capture as the hourly scheduler. Without body: captures every day still missing or not final. With days: re-captures those days (within Cloudflare's retention); a day is replaced, never added to.",
        "security": [
          {
            "ApiKeyAuth": []
          }
        ],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "days": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "example": [
                      "2026-09-28"
                    ]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Capture result",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BotTrafficCaptureResult"
                }
              }
            }
          },
          "502": {
            "description": "At least one day failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BotTrafficCaptureResult"
                }
              }
            }
          }
        }
      }
    }
  }
}